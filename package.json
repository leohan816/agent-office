{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Office M01 local domain core, read-only observation adapters, and operations dashboard",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=1",
    "test:unit": "vitest run --maxWorkers=1 tests/domain tests/contract tests/snapshot",
    "test:property": "vitest run --maxWorkers=1 tests/property",
    "test:integration": "vitest run --maxWorkers=1 tests/persistence tests/recovery tests/adapters tests/integration tests/acceptance",
    "test:ui": "vitest run --maxWorkers=1 tests/ui",
    "build:core": "tsc -p tsconfig.build.json",
    "build:dashboard": "vite build",
    "build": "npm run build:core && npm run build:dashboard",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
